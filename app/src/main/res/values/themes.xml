<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight parent so the app follows the phone's display mode
         (light / dark / automatic) instead of staying dark.
         NOTE: android:Theme.Material.DayNight.NoActionBar does not exist,
         so the ActionBar is switched off here instead. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
